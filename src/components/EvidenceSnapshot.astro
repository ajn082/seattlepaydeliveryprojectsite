---
import { evidence } from "../content/copy";
import { sources } from "../content/sources";
import Citation from "./Citation.astro";
---

<div class="evidence-grid">
  {evidence.map((item) => (
    <article class="evidence-item">
      <p class="evidence-label">{item.label}</p>
      <h3>{item.title}</h3>
      <p>{item.body}</p>
      <p class="evidence-limitation">
        <strong>Read with this in mind:</strong> {item.limitation}
      </p>
      <a class="text-link" href={sources[item.source].url}>
        {item.link} <span aria-hidden="true">↗</span>
      </a>
      <Citation source={item.source} />
    </article>
  ))}
</div>
