---
import { withBase } from "../utils/urls";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<a
  href={withBase("/get-involved")}
  class:list={["button", "button-outline", "involvement-link", { compact }]}
>
  Get involved <span aria-hidden="true">↗</span>
</a>
