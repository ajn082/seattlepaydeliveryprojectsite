---
import BaseLayout from "../layouts/BaseLayout.astro";
import SurveyLink from "../components/SurveyLink.astro";
import GetInvolvedLink from "../components/GetInvolvedLink.astro";
import TimeExplainer from "../components/TimeExplainer.astro";
import EvidenceSnapshot from "../components/EvidenceSnapshot.astro";
import Citation from "../components/Citation.astro";
import Status from "../components/Status.astro";
import HeroArtwork from "../components/HeroArtwork.astro";
import SectionSticker from "../components/SectionSticker.astro";
import { copy, topics } from "../content/copy";
import { site, privacyReady } from "../config/site";
const c = copy.home;
const emphasisWords = c.headlineEmphasis.split(" ");
---

<BaseLayout title={c.title} description={c.description} story>
  <div class="hero-stage">
    <section class="home-hero container" aria-labelledby="hero-title">
      <div class="hero-meta">
        <div class="hero-meta-copy">
          <p class="eyebrow">{c.eyebrow}</p>
        </div>
      </div>
      <div class="hero-main">
        <h1 id="hero-title" aria-label={`${c.headline} ${c.headlineEmphasis}`}>
          <span aria-hidden="true">
            {c.headline
              .split(/(delivery-pay)/)
              .map((part) =>
                part === "delivery-pay" ? (
                  <span class="nowrap headline-keyword">{part}</span>
                ) : (
                  part
                ),
              )}{" "}
            <em class="headline-highlight">
              {emphasisWords.map((word, index) => (
                <>
                  <span class="hero-word">
                    {Array.from(word).map((character) => (
                      <span class="hero-char">{character}</span>
                    ))}
                  </span>
                  {index < emphasisWords.length - 1 ? " " : ""}
                </>
              ))}
            </em>
          </span>
        </h1>
        <HeroArtwork />
      </div>
      <div class="hero-bottom">
        <div class="hero-copy">
          <p class="hero-lead">{c.introduction}</p>
          <a class="text-link" href="/research">
            Explore the research <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="hero-actions">
          <SurveyLink />
          <GetInvolvedLink />
        </div>
      </div>
    </section>
  </div>

  <section
    class="issue-section section container"
    aria-labelledby="issue-title"
  >
    <div class="issue-copy">
      <h2 id="issue-title" data-reveal>
        {c.issueTitle}
      </h2>
      <p>{c.issueBody}</p>
      <a class="text-link" href="/research#definitions">
        {c.issueLink} <span aria-hidden="true">↗</span>
      </a>
      <Citation source="ols" label="Time definitions: Seattle OLS" />
    </div>
    <TimeExplainer />
    <p class="hour-statement" data-hour-statement>
      <span>{c.hourStatement[0]}</span>
      <strong>{c.hourStatement[1]}</strong>
      <span class="hour-statement-arrow" aria-hidden="true">
        ↗
      </span>
      <span class="statement-rule" aria-hidden="true"></span>
    </p>
  </section>

  <section
    class="section section-ruled container"
    aria-labelledby="evidence-title"
  >
    <div class="section-heading">
      <h2 id="evidence-title">{c.evidenceTitle}</h2>
      <p>{c.evidenceIntro}</p>
    </div>
    <EvidenceSnapshot />
    <p class="section-footnote">
      Published research, not findings from this project.{" "}
      <a href="/research#methodology">Read how our study is designed.</a>
    </p>
  </section>

  <section
    class="section topics-section container"
    aria-labelledby="topics-title"
  >
    <div class="section-heading">
      <SectionSticker kind="phone-time" />
      <h2 id="topics-title">{c.topicsTitle}</h2>
      <p>{c.topicsIntro}</p>
    </div>
    <dl class="topic-grid">
      {topics.map((topic) => (
        <div data-topic>
          <dt>{topic.title}</dt>
          <dd>{topic.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section
    class="participate-section container"
    aria-labelledby="participate-title"
  >
    <div class="participate-panel">
      <div class="participate-message">
        <span class="invitation-backdrop" aria-hidden="true"></span>
        <p class="eyebrow">For delivery workers</p>
        <h2 id="participate-title">{c.invitationTitle}</h2>
      </div>
      <div class="participate-body">
        <p>{c.invitationBody}</p>
        <p class="small-copy">
          {site.survey.duration} Participation is voluntary. No names or email
          addresses are requested; avoid identifying details in comments or
          optional uploads.
        </p>
        <SurveyLink />
        <a href="/workers" class="text-link">
          Participation & what to expect <span aria-hidden="true">↗</span>
        </a>
        {!privacyReady && (
          <p class="small-copy">
            Response access and retention details are still pending.{" "}
            <a href="/privacy">Read the privacy notice.</a>
          </p>
        )}
      </div>
    </div>
  </section>

  <section
    class="section involvement-section container"
    aria-labelledby="involvement-title"
  >
    <span class="involvement-backdrop" aria-hidden="true"></span>
    <SectionSticker kind="delivery-bag" />
    <div class="involvement-heading">
      <h2 id="involvement-title">{c.involvementTitle}</h2>
    </div>
    <div>
      <p>{c.involvementBody}</p>
      <GetInvolvedLink />
    </div>
  </section>

  <section
    class="section section-ruled progress-section container"
    aria-labelledby="progress-title"
  >
    <Status />
    <div class="progress-content">
      <h2 id="progress-title">{c.progressTitle}</h2>
      <div>
        <p>{c.progressBody}</p>
        <a class="text-link" href="/updates">
          Follow the progress <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
