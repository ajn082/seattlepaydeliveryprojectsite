---
import { withBase } from "../utils/urls";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import TimeExplainer from "../components/TimeExplainer.astro";
import EvidenceSnapshot from "../components/EvidenceSnapshot.astro";
import Citation from "../components/Citation.astro";
import SurveyLink from "../components/SurveyLink.astro";
import Status from "../components/Status.astro";
import { copy } from "../content/copy";
import { research } from "../content/research";
import { sources } from "../content/sources";
import { site, contactHref, formatDate } from "../config/site";
const c = copy.research;
const sections = [
  { href: "#policy", label: "The policy" },
  { href: "#question", label: "The question" },
  { href: "#definitions", label: "Key definitions" },
  { href: "#evidence", label: "Existing evidence" },
  { href: "#methodology", label: "Our methods" },
  { href: "#sources", label: "Sources" },
];
---

<BaseLayout title={c.title} description={c.description} story>
  <PageIntro
    label={c.title}
    headline={c.headline}
    introduction={c.introduction}
  />
  <div class="container reading-layout">
    <aside class="page-contents">
      <nav aria-label="On this page">
        <p>In this research</p>
        {sections.map((s) => (
          <a href={s.href}>{s.label}</a>
        ))}
      </nav>
      <p class="review-date">
        Sources last reviewed
        <br />
        {formatDate(site.reviewedAt)}
      </p>
    </aside>
    <div class="research-body">
      <section id="policy" class="article-section">
        <h2>What the law changed.</h2>
        {research.policy.map((p) => (
          <p>{p}</p>
        ))}
        <Citation
          source="ordinance"
          label="Read the official ordinance explanation"
          reviewed
        />
      </section>
      <section id="question" class="article-section">
        <h2>The question we’re asking.</h2>
        <blockquote class="research-question">{c.question}</blockquote>
      </section>
      <section id="definitions" class="article-section">
        <h2>Count the hours. Define the earnings.</h2>
        <TimeExplainer />
        <dl class="definition-list">
          {research.definitions.map((d) => (
            <div>
              <dt>{d.term}</dt>
              <dd>{d.definition}</dd>
            </div>
          ))}
        </dl>
        <Citation
          source="ordinance"
          label="Official coverage and engaged-time rules"
        />
        <Citation source="ols" label="OLS time and pay definitions" />
      </section>
      <section class="article-section">
        <h2>Why the whole picture matters.</h2>
        {research.mechanisms.map((p) => (
          <p>{p}</p>
        ))}
        <Citation
          source="nber"
          label="Economic mechanisms examined in An, Garin & Kovak"
        />
      </section>
      <section id="evidence" class="article-section">
        <h2>What previous research shows.</h2>
        <EvidenceSnapshot />
        <p>{research.comparison}</p>
        <p class="small-copy">
          The NBER source is a working paper. The summaries here describe the
          cited publications, not a conclusion from this project.
        </p>
      </section>
      <section id="survey" class="article-section">
        <h2>Listening to workers directly.</h2>
        <p>{research.surveyIntro}</p>
        <ul class="prose-list">
          {research.surveyTopics.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
        <p>{research.surveyNote}</p>
        <p class="small-copy">
          Questionnaire reviewed {formatDate(site.reviewedAt)}.{" "}
          <a href={withBase("/privacy")}>Participation and privacy details.</a>
        </p>
        <SurveyLink />
      </section>
      <section id="methodology" class="article-section">
        <h2>What this study can, and can’t, tell us.</h2>
        <div class="method-list">
          {research.methods.map((m) => (
            <div>
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </div>
          ))}
        </div>
      </section>
      <section id="about" class="article-section">
        <h2>Independent. Worker-centered. Open to the evidence.</h2>
        <p>{research.about}</p>
        <p>{research.advocacy}</p>
        <a class="text-link" href={contactHref()}>
          Contact {site.researcher} <span aria-hidden="true">↗</span>
        </a>
      </section>
      <section id="sources" class="article-section sources-section">
        <h2>Go straight to the sources.</h2>
        <ol class="source-list">
          {(["ordinance", "ols", "nber", "rights", "languages"] as const).map(
            (id) => {
              const s = sources[id];
              return (
                <li id={`source-${id}`}>
                  <a href={s.url}>
                    {s.title}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                  <p>
                    {s.publisher}. {s.date}.
                  </p>
                  <p class="small-copy">{s.note}</p>
                </li>
              );
            },
          )}
        </ol>
        <p class="review-date">
          Last reviewed {formatDate(site.reviewedAt)}. Source publication dates
          and study periods are shown separately.
        </p>
      </section>
      <section class="article-section publication-status">
        <Status />
        <h2>Project findings are not yet published.</h2>
        <p>
          The survey is open. An analysis and public summary will follow only
          when they are ready, with the evidence and limitations alongside them.
        </p>
        <a class="text-link" href={withBase("/updates")}>
          Read project updates <span aria-hidden="true">↗</span>
        </a>
      </section>
    </div>
  </div>
</BaseLayout>
