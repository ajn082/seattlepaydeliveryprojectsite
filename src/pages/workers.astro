---
import BaseLayout from "../layouts/BaseLayout.astro";
import SurveyLink from "../components/SurveyLink.astro";
import { copy } from "../content/copy";
import { participation as p } from "../content/participation";
import { site, contactHref, formatDate, privacyReady } from "../config/site";
import { sources } from "../content/sources";
const c = copy.workers;
---

<BaseLayout title={c.title} description={c.description}>
  <section class="worker-hero container">
    <p class="eyebrow">For delivery workers</p>
    <h1>
      {c.headline}
      <br /> <em>{c.headlineEmphasis}</em>
    </h1>
    <p class="page-lead">{c.introduction}</p>
    <div class="worker-actions">
      <SurveyLink />
      <span>{site.survey.duration}</span>
    </div>
    <p class="eligibility">
      <strong>Who can take part?</strong> {site.survey.eligibility}
    </p>
    <p class="small-copy worker-privacy">
      No names or email addresses are requested.{" "}
      <a href="/privacy">Read the participation & privacy notice.</a>
    </p>
    <p class="small-copy worker-choice">{p.voluntary}</p>
  </section>
  <div class="container worker-content">
    <section class="worker-expect section-ruled" aria-labelledby="expect-title">
      <h2 id="expect-title">A few things to know.</h2>
      <div class="worker-facts">
        <div>
          <h3>About the questions</h3>
          <p>
            The survey asks about your work, typical earnings, delivery apps,
            and experiences over time. Demographics, comments, and screenshot
            uploads are optional.
          </p>
        </div>
        <div>
          <h3>Leave personal details out</h3>
          <p>{p.noIdentifiers}</p>
        </div>
        <div>
          <h3>Your answers have a purpose</h3>
          <p>{p.purpose}</p>
        </div>
      </div>
    </section>
    <section class="worker-screenshot">
      <h2>Sharing a screenshot? Remove personal details first.</h2>
      <p>{p.uploads}</p>
    </section>
    <section class="article-section narrow">
      <h2>What happens to responses?</h2>
      <p>{p.use}</p>
      <p>{p.anonymity}</p>
      {!privacyReady && (
        <div class="notice">
          <h3>Privacy details still to confirm</h3>
          <p>{p.pending}</p>
        </div>
      )}
      <a class="text-link" href="/privacy">
        Read the participation & privacy notice{" "}
        <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section class="section section-ruled rights-section">
      <div class="section-heading">
        <h2>Know your rights.</h2>
        <p>{p.rights}</p>
      </div>
      <div class="resource-links">
        {(["ordinance", "factSheet", "languages"] as const).map((id) => (
          <a href={sources[id].url}>
            <span>
              {sources[id].title}
              {id === "factSheet" && <small>PDF</small>}
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <p class="small-copy">{p.language}</p>
      <p class="review-date">
        Official resource links last reviewed {formatDate(site.reviewedAt)}.
      </p>
    </section>
    <section class="worker-contact section-ruled">
      <h2>Questions before you take part?</h2>
      <p>
        Contact {site.researcher}, the independent student researcher behind the
        project.
      </p>
      <a
        class="email-link"
        href={contactHref("Question about the Seattle Delivery Worker Survey")}
      >
        {site.contactEmail} <span aria-hidden="true">↗</span>
      </a>
      <div class="worker-final-action">
        <SurveyLink />
      </div>
    </section>
  </div>
</BaseLayout>
